# Root-level ignore rules

# OS
.DS_Store

# Env files
.env*

# Logs
npm-debug.log*
yarn-debug.log*
.pnpm-debug.log*

# Node
node_modules/

# Next.js build
.next/
out/

# Anchor/Solana artifacts
**/target/
**/.anchor/
**/test-ledger/

# Solana keypairs (keep out of repo if ever copied in)
**/id.json
**/*-keypair.json

# IDE
.vscode/
